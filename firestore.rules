rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isReasonableSize() {
      return request.resource.data.keys().size() < 30;
    }

    // Test connection check
    match /test/{document} {
      allow read, write: if true;
    }

    // Users collection - Zero-knowledge profiles & virtual numbers
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isReasonableSize()
        && request.resource.data.assignedNumber is string
        && request.resource.data.assignedNumber.size() <= 64;
      allow delete: if true;
    }

    // Unique username reservations registry
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if isReasonableSize() && username.size() <= 50;
      allow delete: if true;
    }

    // Phone numbers registry for instant O(1) number verification across all devices
    match /phone_numbers/{phoneKey} {
      allow read: if true;
      allow create, update: if isReasonableSize() && phoneKey.size() <= 64;
      allow delete: if true;
    }

    // Call Records collection (audit trails)
    match /call_records/{recordId} {
      allow read: if true;
      allow create, update: if isReasonableSize();
      allow delete: if true;
    }

    // Real-time Calling Signals (WebRTC handshake with anti-replay timestamp limits)
    match /signals/{signalId} {
      allow read: if true;
      allow create: if isReasonableSize()
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() <= 128
        && request.resource.data.senderId is string;
      allow update, delete: if true;
    }

    // Audio Rooms & WebRTC Sessions
    match /rooms/{roomId} {
      allow read, write, create, delete: if isReasonableSize();
    }
    match /rooms/{roomId}/{subcollection=**} {
      allow read, write, create, delete: if true;
    }

    // In-Call Whispers & Ephemeral Messages (Payload flood protection)
    match /in_call_messages/{msgId} {
      allow read: if true;
      allow create: if isReasonableSize()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow update, delete: if true;
    }
  }
}
