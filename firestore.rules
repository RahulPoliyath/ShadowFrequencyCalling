rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection - Allow read & write so zero-knowledge clients can register and lookup virtual numbers
    match /users/{userId} {
      allow read, write: if true;
    }

    // Unique username reservations registry
    match /usernames/{username} {
      allow read, write: if true;
    }

    // Phone numbers registry for instant O(1) number verification across all devices
    match /phone_numbers/{phoneKey} {
      allow read, write: if true;
    }

    // Call Records collection
    match /call_records/{recordId} {
      allow read, write, delete: if true;
    }

    // Real-time Calling Signals (incoming call rings & WebRTC audio handshake)
    match /signals/{signalId} {
      allow read, write, create, delete: if true;
    }

    // Audio Rooms & WebRTC Sessions
    match /rooms/{roomId} {
      allow read, write, create, delete: if true;
    }
    match /rooms/{roomId}/{subcollection=**} {
      allow read, write, create, delete: if true;
    }

    // In-Call Whispers & Ephemeral Messages
    match /in_call_messages/{msgId} {
      allow read, write, create, delete: if true;
    }
  }
}
